[credential "https://github.com"]
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/usr/bin/gh auth git-credential
[user]
	name = sen-tou
	email = 29461308+sen-tou@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub
[add "interactive"]
	useBuiltin = False
[core]
	excludesfile = ~/.gitignore.global
	pager = delta
	editor = nvim
[delta]
	alwaysnavigate = True
	alwayslight = False
[diff]
	colorMoved = default
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictstyle = diff3
[include]
	path = ~/.gitconfig.local
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
